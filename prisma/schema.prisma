// PostgreSQL 18.6 datasource, Prisma ORM v7 (driver-adapter client, connection configured in prisma.config.ts).
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum GuardianRelationship {
  parent
  legal_guardian
  other_authorized_guardian

  @@map("guardian_relationship")
}

enum DoctorVerificationStatus {
  Pending
  Verified
  Rejected

  @@map("doctor_verification_status")
}

enum CaseStatus {
  Draft

  @@map("case_status")
}

// Admin-extensible reference table (AD-15). Doctor.specialties (added in a later story)
// will be a many-to-many join against this table.
model Specialty {
  id             String   @id @default(uuid())
  name           String   @unique
  normalizedName String   @unique @map("normalized_name")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  doctors        DoctorSpecialty[]

  @@map("specialties")
}

model Doctor {
  id                 String                   @id @default(uuid())
  mobileNumber       String                   @unique @map("mobile_number")
  fullName           String                   @map("full_name")
  username           String                   @unique
  passwordHash       String                   @map("password_hash")
  upiId              String?                  @map("upi_id")
  verificationStatus DoctorVerificationStatus @default(Pending) @map("verification_status")
  specialties        DoctorSpecialty[]
  credentials        DoctorCredential[]
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@map("doctors")
}

model DoctorSpecialty {
  doctorId   String    @map("doctor_id")
  specialtyId String   @map("specialty_id")
  doctor     Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty  Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@id([doctorId, specialtyId])
  @@map("doctor_specialties")
}

model DoctorCredential {
  id               String   @id @default(uuid())
  doctorId         String   @map("doctor_id")
  fileName         String   @map("file_name")
  contentType      String   @map("content_type")
  sizeBytes        Int      @map("size_bytes")
  storageKey       String   @unique @map("storage_key")
  doctor           Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("doctor_credentials")
}

model AdminAccount {
  id           String   @id
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_accounts")
}

// Single Admin-owned settings record (AD-16): Case fees + Platform Fee percentage.
// A settings change applies prospectively only -- see AD-16.
model PlatformSettings {
  id                 String   @id @default(uuid())
  standardCaseFee    Decimal  @map("standard_case_fee") @db.Decimal(10, 2)
  urgentCaseFee      Decimal  @map("urgent_case_fee") @db.Decimal(10, 2)
  platformFeePercent Decimal  @map("platform_fee_percent") @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// Patients module's own table (AD-2). mobileNumber is unique at the DB level
// as defense in depth alongside the application-level duplicate check.
// passwordHash stays null until Story 1.3's post-OTP password setup.
model Patient {
  id                   String                @id @default(uuid())
  mobileNumber         String                @unique @map("mobile_number")
  username             String?               @unique
  passwordHash         String?               @map("password_hash")
  isMinor              Boolean               @default(false) @map("is_minor")
  isGuardianRegistered Boolean               @default(false) @map("is_guardian_registered")
  minorName            String?               @map("minor_name")
  guardianRelationship GuardianRelationship? @map("guardian_relationship")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@map("patients")
}

model Case {
  id                 String       @id @default(uuid())
  creationRequestId  String       @unique @map("creation_request_id")
  patientId          String       @map("patient_id")
  affectedBodyArea   String       @map("affected_body_area")
  condition          String
  recommendation     String
  additionalDetails String       @default("") @map("additional_details")
  selectedDoctorId  String?      @map("selected_doctor_id")
  status             CaseStatus   @default(Draft)
  documents          CaseDocument[]
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([patientId, status, updatedAt])
  @@map("cases")
}

model CaseDocument {
  id          String   @id @default(uuid())
  caseId      String   @map("case_id")
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  storageKey  String   @unique @map("storage_key")
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([caseId, createdAt])
  @@map("case_documents")
}
